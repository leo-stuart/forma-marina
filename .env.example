# Supabase — projeto da formatura
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta (Dashboard -> Settings -> API Keys -> Secret keys).
# NUNCA prefixar com NEXT_PUBLIC_: ela nao pode chegar ao navegador.
SUPABASE_SECRET_KEY=

# Token compartilhado das rotas. Vai para o navegador de proposito —
# barra curl casual, nao e seguranca.
NEXT_PUBLIC_APP_TOKEN=

# Dominio de producao. O QR e impresso: nunca pode apontar para localhost
# nem para a URL efemera de um deploy.
NEXT_PUBLIC_SITE_URL=
